<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PIMTray</RootNamespace>
    <AssemblyName>PIMTray</AssemblyName>
    <!-- Let the SDK generate the Win32 version resource from the metadata below, and embed
         the app icon + manifest, instead of a hand-maintained .res (which hardcoded the
         version and required an external resource compiler to update). -->
    <ApplicationIcon>Resources\tray.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The installer packages a single PIMTray.exe, so publish must bundle the managed
         assembly, deps.json, and runtimeconfig.json into the apphost. Without this, the
         installed .exe is only a launcher and fails with "PIMTray.dll does not exist".
         Publish with a RID (framework-dependent), e.g. dotnet publish -r win-x64. -->
    <PublishSingleFile>true</PublishSingleFile>

    <Product>PIM Tray</Product>
    <AssemblyTitle>PIM Tray</AssemblyTitle>
    <Description>Activate Entra ID PIM roles from the Windows tray.</Description>
    <Company>Thomas Marcussen</Company>
    <Authors>Thomas Marcussen</Authors>
    <Copyright>Copyright (c) 2026 Thomas Marcussen</Copyright>
    <Trademark>Thomas Marcussen</Trademark>
    <Version>1.1.1</Version>
    <FileVersion>1.1.1.0</FileVersion>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.66.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

</Project>
